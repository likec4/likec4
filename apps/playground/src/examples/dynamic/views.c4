views {

  view customer of customer {
    include
      customer,
      cloud,
      cloud.ui

    style cloud {
      opacity 40%
      color secondary
    }
    style cloud.* {
      color secondary
    }
  }

  view cloud of cloud {
    include *
    autoLayout LeftRight
  }

  view ui of cloud.ui {
    include
      *,
      cloud.backend._,
    exclude
      cloud.api -> cloud.auth
  }

  view backend of cloud.backend {
    include
      cloud,
      *,
      backend.* -> cloud.storage with {
        title ''
      }

    style cloud, backend {
      opacity 40%
      color muted
    }
    style backend._ {
      color green
    }
  }

  view storage of cloud.storage {
    include
      *,
      cloud.backend._
  }

  view noteCards {
    title 'View notes for elements and connections'

    include customer
    include cloud.ui.web with {
      notes '''
        **Customer Dashboard** is the browser entry point for this flow.

        This note belongs to this view. It leaves the model definition of the dashboard unchanged.
      '''
    }
    include customer -> cloud.ui.web with {
      notes '''
        The customer opens the dashboard over a secure browser connection.

        The dashed line from this card points to the connection, not to either element.
      '''
    }

    autoLayout LeftRight
  }
}
