{
  "$schema": "https://turbo.build/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "generate": {
      "dependsOn": [
        "^generate",
        "@likec4/react#build",
        "likec4#build"
      ],
      "outputs": [
        ".astro/**"
      ]
    },
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.mdx",
        "!**/*.md"
      ],
      "dependsOn": [
        "^typecheck",
        "sources",
        "generate"
      ],
      "outputs": [
        "lib/**",
        "*.tsbuildinfo"
      ],
      "outputLogs": "new-only"
    },
    "build": {
      "dependsOn": [
        "generate"
      ],
      "outputs": [
        ".astro/**",
        "dist/**"
      ]
    }
  }
}
