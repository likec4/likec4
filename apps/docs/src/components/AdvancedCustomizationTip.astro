---
import { Aside } from "@astrojs/starlight/components";

// Keep the reader in their locale (pages that are not translated fall back to English)
const localePrefix = Astro.url.pathname.startsWith("/pt-br/") ? "/pt-br" : "";
---

<Aside type="tip" title="Customization">
  <p>
    To replace parts of the UI with your own React components, like the logo or the shapes of the elements, see <a
      href={`${localePrefix}/tooling/customization/`}
    >UI customization</a>.
  </p>
  <p>
    For a complete app with custom node renderers, overlays and toolbars, see the <a
      href="https://github.com/likec4/example-customization"
      target="_blank"
    >example-customization</a> repository (<a
      href="https://stackblitz.com/~/github.com/likec4/example-customization"
      target="_blank"
    >open in StackBlitz</a>).
  </p>
</Aside>
