{
  "lineWidth": 120,
  "newLineKind": "lf",
  "incremental": true,
  "useTabs": false,
  "typescript": {
    "semiColons": "asi",
    "operatorPosition": "maintain",
    "bracePosition": "maintain",
    "trailingCommas": "onlyMultiLine",
    "conditionalType.operatorPosition": "maintain",
    "binaryExpression.operatorPosition": "maintain",
    "importDeclaration.sortTypeOnlyImports": "first",
    "importDeclaration.preferSingleLine": false,
    "exportDeclaration.preferSingleLine": false,
    "quoteStyle": "alwaysSingle",
    "nextControlFlowPosition": "maintain",
    "jsxOpeningElement.bracketPosition": "maintain",
    "jsx.quoteStyle": "preferDouble",
    "jsxSelfClosingElement.bracketPosition": "maintain",
    "jsx.bracketPosition": "maintain",
    "unionAndIntersectionType.preferHanging": false,
    "unionAndIntersectionType.preferSingleLine": false
  },
  "json": {
  },
  "excludes": [
    "**/node_modules",
    "**/*-lock.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    ".changeset",
    "CLAUDE.md",
    "AGENTS.md",
    "CHANGELOG.md",
    ".turbo",
    ".astro",
    ".vscode",
    ".vscode-test-web",
    ".next",
    ".fleet",
    "dist",
    "packages/icons/**",
    "packages/*/contrib",
    "packages/*/lib",
    "packages/vscode/src/meta.ts",
    "**/routeTree.gen.ts",
    "packages/*/src/generated",
    "packages/layouts/src/graphviz/ai/prompt-system.md",
    "styled-system/preset/src/generated.ts",
    "schemas/likec4-config.schema.json"
  ],
  "markdown": {
  },
  "toml": {},
  "yaml": {
    "quotes": "preferSingle"
  },
  "malva": {},
  "markup": {},
  "plugins": [
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/markdown@0.26.0",
    "npm:@dprint/toml@0.9.0",
    "npm:dprint-plugin-malva@0.16.0",
    "npm:dprint-plugin-markup@0.27.5",
    "npm:dprint-plugin-yaml@0.6.0"
  ]
}
