{
  "$schema": "https://turbo.build/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "generate": {
      "inputs": [
        "scripts/generate.ts",
        "src/**/*.md"
      ],
      "outputs": [
        "src/**/*.generated.ts"
      ]
    },
    "typecheck": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "!src/**/*.generated.ts",
        {
          "mode": "jit",
          "globs": ["src/**/*.generated.ts"],
        },
      ]
    },
  }
}
