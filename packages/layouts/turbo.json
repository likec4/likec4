{
  "$schema": "https://turbo.build/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "generate": {
      "inputs": [
        "scripts/generate.mts",
        "src/**/*.md"
      ],
      "outputs": [
        "src/**/*.generated.ts"
      ],
      "outputLogs": "new-only"
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck",
        "sources",
        "generate"
      ],
      "inputs": [
        "src/**/*.{js,jsx,mjs,ts,tsx,mts}",
        "*.tsconfig*",
        "!src/**/*.generated.ts",
        {
          "mode": "jit",
          "globs": ["src/**/*.generated.ts"],
        },
      ],
      "outputs": [
        "lib/**",
        "*.tsbuildinfo"
      ],
      "outputLogs": "new-only"
    },
  }
}
