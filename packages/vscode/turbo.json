{
  "$schema": "https://turbo.build/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "generate": {
      "inputs": ["package.json"],
      "outputs": [
        "src/meta.ts"
      ]
    },
    "typecheck": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "!src/meta.ts",
        {
          "mode": "jit",
          "globs": ["src/meta.ts"],
        },
      ]
    },
    "build": {
      "outputs": [
        "$TURBO_EXTENDS$",
        "data/skills/**",
        "data/config.schema.json",
        "dist/**"
      ],
      "outputLogs": "new-only"
    },
  }
}
