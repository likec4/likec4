{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@likec4/tsconfig/base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "verbatimModuleSyntax": true,
    "composite": true,
    "lib": [
      "ESNext",
      "DOM"
    ],
    "paths": {
      "@likec4/styles/*": [
        "./styled-system/*/index.d.mts",
        "./styled-system/*/index.mjs",
        "./styled-system/*"
      ]
    }
  },
  "files": [
    "src/index.ts"
  ],
  "references": [
    {
      "path": "../diagram/"
    }
  ]
}
