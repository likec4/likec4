{
  "$schema": "https://turbo.build/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "typecheck": {
      "dependsOn": [
        "@likec4/styles#sources",
        "@likec4/diagram#typecheck",
      ],
      "inputs": [
        "src/*.ts",
        "tsconfig.json",
      ]
    },
    "build": {
      "dependsOn": [
        "sources",
        "@likec4/diagram#build"
      ]
    }
  }
}
