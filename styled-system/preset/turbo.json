{
  "$schema": "https://turbo.build/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "sources": {
      "dependsOn": ["@likec4/devops#sources"],
      "inputs": [
        "src/**",
        "tsdown.config.mts"
      ],
      "cache": true,
      "outputs": [
        "dist/**"
      ]
    },
    "pack": {
      "dependsOn": ["sources"],
      "outputs": ["*.tgz"],
      "cache": false
    }
  }
}
